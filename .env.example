# Copy this file to `.env` and fill in your MongoDB Atlas credentials.
# The .env file is git-ignored and loaded automatically by the backend and loader.
#
# IMPORTANT: if your password contains special characters (@ : / ? # etc.)
# you must URL-encode them, e.g. '@' becomes '%40'.

# MongoDB Atlas SRV connection string.
# Get it from Atlas: Database > Connect > Drivers > Python.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name used for all analytics collections.
DATABASE_NAME=web_log_analytics
